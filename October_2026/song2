$: setcpm(60)

const drum1 = sound(`
[-  -  oh - ] [-  ~  ~  - ] [-  -  -  - ] [-  -  -  - ],
[hh hh -  - ] [hh -  hh - ] [hh -  hh - ] [hh -  hh - ],
[-  -  -  - ] [cp -  -  - ] [-  -  -  - ] [cp -  -  - ],
[bd -  -  - ] [-  -  -  bd] [-  -  bd - ] [-  -  -  bd]
`).slow(4).distort(3).gain(0.4)._punchcard().color("cyan orange");

const bass1 =  n("<[[0 <2 5>]/4[<1 3> <7 11 5>]]>".add(-7)).slow(2).scale("g:minor")
  .sound("wt_digital_bad_day").adsr(0, 0.9, 0.8, 0.02).distort(2).gain(1.5).room(2)
const bass2 =  n("<[[0 <2 5>]/4[<1 3> <7 11 5>]]>".add(-7)).scale("g:minor")
  .sound("wt_digital_bad_day").adsr(0, 0.9, 0.8, 0.02).distort(2).gain(1.5).room(2)
const melody1 = n(`<[[0 <2 5>]/2[<1 3> <7 3 9>]] 
                    [[0 <2 5>]/4[<1 3> <7 3 9>]] 
                    [[2 4]/2[<1 4> <10 9>]]>`).scale("g:minor")
  .sound("wt_digital_bad_day").adsr(0.05, 0.9, 0.7, 0.02).distort(2).gain(1.1)

const partA = stack(drum1, bass1)
const partB = stack(drum1, bass2, melody1)

$: arrange(
  [12, partA],
  [12, partB],
  [1, silence]
)